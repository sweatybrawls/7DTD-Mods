<Configs>
    <set xpath="/windows/window[@name='windowTargetBar']/@visibility">always</set>
    <remove xpath="/windows/window[@name='windowTargetBar']/rect" />
    <append xpath="/windows/window[@name='windowTargetBar']">
        <rect pos="-200,-90" width="550" height="35" visible="true">
            <filledsprite depth="0" name="BarContent" sprite="ui_game_header_fill" type="simple" color="255,0,0,135" width="400" fill="{fill}" globalopacity="false"/>
            <sprite depth="0" name="border" sprite="ui_game_header_fill" color="150,150,150,25" type="simple" width="400" globalopacity="false"/>
            <label depth="0" name="TextContent" pos="-9999,-9999" font_size="0" color="255,255,255,0" justify="center" pivot="center" text="{name}: {text=0}" height="0" visibility="false" />
        </rect>
    </append>
</Configs>
